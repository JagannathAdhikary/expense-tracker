# Supabase project credentials (safe to expose the anon key in the browser;
# Row-Level Security in the database is what protects data). Copy to .env and fill in.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (optional — enables group notifications). PUBLIC VAPID key only; the
# private key lives in Supabase secrets, never in the client.
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
